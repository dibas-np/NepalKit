# Optional overrides for the scripts in scripts/. To use them, copy this file
# to .env, uncomment the lines you need, and run `set -a; . ./.env; set +a`.

# The notarytool keychain profile for scripts/package-release.sh (default: NepalKit-notary)
# NOTARY_PROFILE=
# The directory that holds Sparkle's generate_appcast and sign_update (default: the copy in DerivedData)
# SPARKLE_BIN=
# The download cache for scripts/verify-data-sources.py (default: ~/.cache/nepalkit-data-sources)
# NEPAKIT_DATA_CACHE=
# The Homebrew tap clone for scripts/update-cask.sh (default: homebrew-tap beside this repository)
# NEPAKIT_TAP_DIR=
# The built NepalKit.app Info.plist that scripts/run-app-tests.sh and scripts/verify-deployment-floor.py check (default: each script looks for a build)
# NEPAKIT_BUILT_PLIST=
