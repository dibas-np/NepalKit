# Optional settings for the release scripts. Export them, or `set -a; . ./.env; set +a`.

# Apple Developer team ID (required by scripts/package-release.sh)
# TEAM_ID=
# notarytool keychain profile (default: NepalKit-notary)
# NOTARY_PROFILE=
# Directory containing Sparkle's generate_appcast (default: the copy in DerivedData)
# SPARKLE_BIN=
# Set to 1 to allow a SPARKLE_BIN outside a checkout of the pinned Sparkle version
# SPARKLE_BIN_UNPINNED=
# Cache for scripts/verify-data-sources.py (default: ~/.cache/nepalkit-data-sources)
# NEPAKIT_DATA_CACHE=
# Homebrew tap clone for scripts/update-cask.sh (default: ../homebrew-tap)
# NEPAKIT_TAP_DIR=
# Built NepalKit.app Info.plist for scripts/run-app-tests.sh (default: discovered)
# NEPAKIT_BUILT_PLIST=
