<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Watch app's Info.plist, explicit for the same reason the macOS app's is:
  the Info.plist generator consumes only the settings on its allowlist and a
  name outside it builds green while producing no key at all. WKWatchOnly and
  WKApplication are exactly the keys a Watch-only app cannot afford to lose,
  so they live here in full rather than as INFOPLIST_KEY_* settings.

  Versions and the bundle identifier are substituted from the build settings
  rather than duplicated here, so there is still exactly one place to change
  them.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>NepalKit</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- SwiftUI app lifecycle; the watch-only flag keeps this product out of
	     any companion-iOS packaging path. -->
	<key>WKApplication</key>
	<true/>
	<key>WKWatchOnly</key>
	<true/>
</dict>
</plist>
