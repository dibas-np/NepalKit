.build/
build/
.swiftpm/
DerivedData/
*.xcuserdata/
-xcc/
.env

# Agent workflow (local-only, never committed)
AGENTS.md
docs/agents/

# ...except the product spec, which is durable project knowledge and is
# reviewed in PRs. Ignores one level below each .scratch/<feature>/ directory
# rather than the directory itself: git cannot re-include a file whose parent
# directory is excluded, so excluding .scratch/ outright would make the
# negation below unreachable.
.scratch/*/*
!.scratch/*/spec.md
